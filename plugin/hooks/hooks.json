{
  "description": "The Everdict development loop: a session opens with the service's knowledge and every change is refused, every time, until it has named a campaign — a local subagent's edits are refused even after one is named, and delegation-required refuses the session's own hand-edit tools too — and may not end having changed code without a ROUND on the record — what was run, with its numbers — beside what it learned (docs/architecture/change-campaigns.md); and a pull request opened or merged with `gh` is recorded on its issue (and a merge left unrecorded is owed once at Stop); a raw HTTP call to the API that would bypass the door's receipts is refused, and the checks on what a record says (its workspace, a round's commit times, the delegation bootstrap, issue conventions) run in the REST door, `bin/everdict-api`, before or after the call. A prompt that touches open issues is shown them once each (UserPromptSubmit, read through the door, silent on any failure). A linked session's first Read/Grep/Glob/Bash is denied once until it has read from Everdict.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs\"",
            "timeout": 10,
            "statusMessage": "everdict: service context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/capture-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "everdict: capture guard"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/first-change-guard.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/image-push-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "everdict: image push guard"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/raw-http-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "everdict: raw HTTP guard"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/read-first-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "everdict: read-first gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/first-change-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "everdict: first-change guard"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/pr-record-hook.mjs\"",
            "timeout": 120,
            "statusMessage": "everdict: recording the pull request"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/prompt-context.mjs\"",
            "timeout": 5,
            "statusMessage": "everdict: open issues this prompt touches"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-end.mjs\"",
            "timeout": 30,
            "statusMessage": "everdict: unpairing this session's runners"
          }
        ]
      }
    ]
  }
}
